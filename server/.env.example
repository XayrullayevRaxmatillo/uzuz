# --- Server ---
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string.
# Leave EMPTY in development to use a local embedded MongoDB (data kept in server/.mongo-data).
MONGODB_URI=

# Comma-separated list of allowed frontend origins (CORS + Socket.IO).
CLIENT_URL=http://localhost:5173

# Cookie settings. For a frontend on a different domain (e.g. Vercel + Render) use
# COOKIE_SECURE=true and COOKIE_SAMESITE=none. When the server also serves the client, keep lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the app (Render/Railway/Fly = 1).
TRUST_PROXY=0

# Optional: bootstrap the first admin on startup if no admin exists yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: serve the built client (client/dist) from this server. Auto-detected when the folder exists.
SERVE_CLIENT=auto

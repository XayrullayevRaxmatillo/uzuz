{
  "rewrites": [{ "source": "/((?!assets/|icons/|favicon.svg|manifest.webmanifest|sw.js|offline.html|theme-init.js|robots.txt).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
